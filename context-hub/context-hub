#!/usr/bin/env python3
"""context-hub — CLI for publishing, subscribing and syncing context entities."""

import hashlib
import json
import os
import sys
import time
from datetime import datetime, timezone
from pathlib import Path
from typing import Optional

# Resolve venv
SCRIPT_DIR = Path(__file__).parent.resolve()
VENV_PYTHON = SCRIPT_DIR / ".venv" / "bin" / "python3"
if VENV_PYTHON.exists() and sys.prefix == sys.base_prefix:
    os.execv(str(VENV_PYTHON), [str(VENV_PYTHON), __file__] + sys.argv[1:])

import httpx
import typer
import yaml
from rich.console import Console
from rich.table import Table

app = typer.Typer(help="Context Hub CLI — publish, subscribe, sync context entities.")
console = Console()

# ---------------------------------------------------------------------------
# Config & Auth
# ---------------------------------------------------------------------------

AUTH_FILE = SCRIPT_DIR / ".auth.json"


def _resolve_config() -> dict:
    """Resolve config from profile system or env vars."""
    try:
        sys.path.insert(0, str(SCRIPT_DIR.parent / ".profiles"))
        from resolver import resolve
        return resolve("context-hub")
    except Exception:
        pass

    url = os.environ.get("CONTEXT_HUB_URL", "")
    email = os.environ.get("CONTEXT_HUB_EMAIL", "")
    password = os.environ.get("CONTEXT_HUB_PASSWORD", "")
    if url:
        return {"CONTEXT_HUB_URL": url, "CONTEXT_HUB_EMAIL": email, "CONTEXT_HUB_PASSWORD": password}

    console.print("[red]No config found. Run: profile add context-hub default[/red]")
    raise typer.Exit(1)


def _get_base_url() -> str:
    config = _resolve_config()
    url = config.get("CONTEXT_HUB_URL", "http://localhost:8000")
    return url.rstrip("/")


def _save_auth(token: str, email: str, base_url: str):
    AUTH_FILE.write_text(json.dumps({
        "token": token,
        "email": email,
        "base_url": base_url,
        "saved_at": datetime.now(timezone.utc).isoformat(),
    }, indent=2))


def _load_auth() -> Optional[dict]:
    if AUTH_FILE.exists():
        try:
            return json.loads(AUTH_FILE.read_text())
        except Exception:
            pass
    return None


def _get_client() -> httpx.Client:
    """Get an authenticated HTTP client."""
    auth = _load_auth()
    base_url = _get_base_url()

    if auth and auth.get("token"):
        # Verify token is still valid
        headers = {"Authorization": f"Bearer {auth['token']}"}
        try:
            r = httpx.get(f"{base_url}/api/users/me", headers=headers, timeout=10)
            if r.status_code == 200:
                return httpx.Client(
                    base_url=base_url,
                    headers=headers,
                    timeout=30,
                )
        except Exception:
            pass

    # Token expired or missing — re-login
    config = _resolve_config()
    email = config.get("CONTEXT_HUB_EMAIL", "")
    password = config.get("CONTEXT_HUB_PASSWORD", "")

    if not email or not password:
        console.print("[red]No credentials. Run: context-hub login[/red]")
        raise typer.Exit(1)

    r = httpx.post(f"{base_url}/api/auth/login", json={"email": email, "password": password}, timeout=10)
    if r.status_code != 200:
        console.print(f"[red]Login failed: {r.text}[/red]")
        raise typer.Exit(1)

    token = r.json()["token"]
    _save_auth(token, email, base_url)
    return httpx.Client(
        base_url=base_url,
        headers={"Authorization": f"Bearer {token}"},
        timeout=30,
    )


def _find_context_store() -> Path:
    """Find the context store directory."""
    # Try relative to workspace
    candidates = [
        Path("/data/workspace/context/store"),
        Path.cwd() / "context" / "store",
        Path.cwd().parent / "context" / "store",
    ]
    for c in candidates:
        if c.is_dir():
            return c
    console.print("[red]Context store not found.[/red]")
    raise typer.Exit(1)


def _parse_frontmatter(content: str) -> tuple[dict, str]:
    """Parse YAML frontmatter from markdown content."""
    if not content.startswith("---"):
        return {}, content
    parts = content.split("---", 2)
    if len(parts) < 3:
        return {}, content
    try:
        fm = yaml.safe_load(parts[1]) or {}
        body = parts[2].strip()
        return fm, body
    except yaml.YAMLError:
        return {}, content


def _rebuild_registry():
    """Rebuild the context store registry."""
    try:
        import subprocess
        subprocess.run(
            ["python3", "registry.py", "build", "context"],
            cwd="/data/workspace",
            capture_output=True,
            timeout=30,
        )
    except Exception:
        pass


