# Instagram App ID — developers.facebook.com > App > Instagram > Business login settings
# ATTENTION: c'est l'Instagram App ID, PAS le Facebook App ID
INSTAGRAM_APP_ID=your-instagram-app-id

# Instagram App Secret — meme page que l'App ID
# ATTENTION: c'est l'Instagram App Secret, PAS le Facebook App Secret
INSTAGRAM_APP_SECRET=your-instagram-app-secret

# Redirect URI — HTTPS obligatoire (utiliser ngrok en dev)
INSTAGRAM_REDIRECT_URI=https://your-domain.com/api/oauth/instagram/callback
