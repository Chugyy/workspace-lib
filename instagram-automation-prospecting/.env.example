# Instagram credentials (pour instagrapi)
INSTAGRAM_USERNAME=your-username
INSTAGRAM_PASSWORD=your-password

# Chemin vers le fichier session serialise (optionnel)
INSTAGRAM_SESSION_FILE=./session.json

# Proxy residentiel dedie (obligatoire pour eviter les bans)
PROXY_URL=http://user:pass@host:port

# HikerAPI — https://hikerapi.com (Scenario B, production)
HIKERAPI_KEY=your-hikerapi-key

# Unipile — https://unipile.com (lecture inbox managed, optionnel)
UNIPILE_API_KEY=your-unipile-key
