# Unipile API — pour l'envoi/réception WhatsApp
# Dashboard : https://app.unipile.com/

# URL du serveur Unipile
UNIPILE_DSN=https://api15.unipile.com:14510

# Clé API : Settings > API Keys
UNIPILE_API_KEY=your_api_key_here

# ID du compte WhatsApp connecté dans Unipile
UNIPILE_ACCOUNT_ID=your_account_id_here
